---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CATEGORY_LABELS: Record<string, string> = {
  'pokemon': 'Pokemon',
  'magic': 'Magic',
  'one-piece': 'One Piece',
  'yugioh': 'Yu-Gi-Oh!',
  'lorcana': 'Lorcana',
  'dragon-ball': 'Dragon Ball',
  'star-wars': 'Star Wars',
  'guide': 'Guide',
  'actualite': 'Actualite',
  'strategie': 'Strategie',
};

const dateFormatted = post.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  /* URL ABSOLUE : schema.org attend une adresse résoluble, et un
     chemin relatif y est aussi inexploitable que dans og:image — même
     bug, corrigé au même endroit. On pointe la vignette sociale, pas le
     logo de TCG : c'est elle qui illustre vraiment l'article. */
  "image": new URL(`/assets/social/${post.id}-og.png`, Astro.site).href,
  "author": {
    "@type": "Organization",
    "name": post.data.author,
    "url": "https://cards-trading.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cards Trading",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cards-trading.com/assets/img/logo.png"
    }
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://cards-trading.com/blog/${post.id}`
  },
  "keywords": post.data.tags.join(", ")
});
---

{/*
  Aperçu social : la vignette 1200×630 générée par
  scripts/vignettes-sociales.mjs, PAS le heroImage.

  Le heroImage n'est qu'un logo de TCG : partagé sur X ou Facebook il
  donnait une carte de lien sans titre lisible. Le format paysage est
  celui qu'attend `summary_large_image` ; un carré y serait rogné au
  centre et couperait le texte.
*/}
<BlogLayout
  title={post.data.title}
  description={post.data.description}
  image={`/assets/social/${post.id}-og.png`}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <article class="blog-article">
    <header class="blog-article-header">
      <span class="blog-card-category">{CATEGORY_LABELS[post.data.category] || post.data.category}</span>
      <h1>{post.data.title}</h1>
      <div class="blog-article-meta">
        <span>Par {post.data.author}</span>
        <span>&middot;</span>
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatted}</time>
        {post.data.tags.length > 0 && (
          <>
            <span>&middot;</span>
            <span>{post.data.tags.map(t => `#${t}`).join(' ')}</span>
          </>
        )}
      </div>
    </header>

    {post.data.heroImage && (
      <img
        class="blog-article-hero-img"
        src={post.data.heroImage}
        alt={post.data.title}
      />
    )}

    <div class="prose">
      <Content />
    </div>

    {/*
      Appel à l'inscription en fin d'article.

      Le blog n'en avait aucun : on y envoyait du trafic social vers des
      pages sans porte de sortie vers la waitlist. C'est le maillon qui
      manquait au tunnel réseaux sociaux → article → inscription.

      Le lien ne porte pas d'utm : la provenance d'origine (x, instagram,
      discord…) est déjà mémorisée par le script du BlogLayout et retrouvée
      côté landing. Ajouter `utm_source=blog` ici écraserait le vrai canal
      d'acquisition par un intermédiaire.
    */}
    <aside class="blog-cta">
      <h2>La bêta Cards-Trading ouvre bientôt</h2>
      <p>
        Scannez votre carte, elle est en vente. Le paiement reste bloqué
        jusqu'à réception. 0 % de commission pendant toute la bêta.
      </p>
      <a class="blog-cta-bouton" href="/#beta">Rejoindre la liste d'attente</a>
    </aside>
  </article>
</BlogLayout>

<style>
  .blog-cta {
    margin: 56px auto 0;
    max-width: 720px;
    padding: 32px 28px;
    border-radius: 20px;
    text-align: center;
    background: linear-gradient(135deg, rgba(41, 151, 255, 0.14) 0%, rgba(255, 255, 255, 0.04) 100%);
    border: 1px solid rgba(41, 151, 255, 0.3);
  }

  .blog-cta h2 {
    margin: 0 0 10px;
    font-size: clamp(20px, 2.6vw, 26px);
    color: #fff;
  }

  .blog-cta p {
    margin: 0 0 22px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    font-size: 15px;
  }

  .blog-cta-bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Au-dessus des 44px de cible tactile, comme les CTA de la landing */
    min-height: 46px;
    padding: 0 28px;
    border-radius: 50px;
    background: linear-gradient(135deg, #2997ff 0%, #0a6fd8 100%);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(41, 151, 255, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blog-cta-bouton:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(41, 151, 255, 0.65);
  }
</style>
